# Copie este arquivo para ".env" e preencha. NUNCA envie o .env para o GitHub.

# Token do bot: Discord Developer Portal → seu app → Bot → Reset Token
DISCORD_TOKEN=

# Opcional: ID do seu servidor de testes. Com ele, os comandos aparecem na hora.
# Deixe vazio para os comandos funcionarem em todos os servidores (demora alguns minutos).
GUILD_ID=

# Onde o banco de dados fica salvo
DB_PATH=data/harle.db

# Opcional: IDs de quem mais pode usar comandos de dono (ex.: /dar-moedas), separados por vírgula.
# O dono do aplicativo no Developer Portal já tem acesso automaticamente.
DONOS_DO_BOT=
